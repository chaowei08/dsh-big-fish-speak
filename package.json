{
  "name": "dsh-big-fish-speak",
  "version": "0.7.65",
  "description": "让 dsh-pet 桌宠用它自己设置页里选的音色念模型输出：新版整段下发，旧版自动按 60 字切，合成失败只跳过该段。",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": "Chaowei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaowei08/dsh-big-fish-speak.git"
  },
  "homepage": "https://github.com/chaowei08/dsh-big-fish-speak#readme",
  "bugs": {
    "url": "https://github.com/chaowei08/dsh-big-fish-speak/issues"
  },
  "keywords": ["dsh", "dsh-plugin", "tts", "speech", "big-fish", "dsh-pet"],
  "files": ["index.js", "client/", "cordis.patch.yml", "README.md", "icon.svg"],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./client": "./client/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
